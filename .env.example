cat > .env.example << 'EOF'
# AWS Configuration
# Configure using: aws configure
# Or set these environment variables:
# export AWS_ACCESS_KEY_ID="your_access_key_here"
# export AWS_SECRET_ACCESS_KEY="your_secret_key_here"
AWS_DEFAULT_REGION=eu-west-1

# GCP Configuration
# Set path to service account key file
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.gcp/terraform-sa-key.json"
GCP_PROJECT_ID=terraform-demo-486102
GCP_REGION=europe-west1

# Terraform Configuration (optional)
# TF_LOG=DEBUG
# TF_LOG_PATH=terraform.log

# Project Configuration
PROJECT_NAME=terraform-demo
ENVIRONMENT=dev
EOF